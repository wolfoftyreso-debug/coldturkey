# ---- API ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://coldturkey:coldturkey@localhost:5432/coldturkey

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Multi-tenancy
DEFAULT_TENANT_SLUG=public
ALLOW_PUBLIC_SIGNUP=true

# AI coach (optional — the app runs without it using the deterministic fallback coach)
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5

# CORS: comma-separated origins, or * for development
CORS_ORIGINS=http://localhost:3000

# ---- Web ----
# Leave NEXT_PUBLIC_API_URL empty when the API is served on the same origin as
# the app — that is how production runs, with the Ingress routing /v1 to the
# API. Set it only for local development, where the API is on another port, and
# then set it for BOTH `next build` and `next start`: the bundle inlines it at
# build time while the Content-Security-Policy is built at run time, and if the
# two disagree the browser refuses every API call with no server-side symptom.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_TENANT=public
