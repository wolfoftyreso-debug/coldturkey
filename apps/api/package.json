{
  "name": "@cleat/api",
  "version": "1.0.0",
  "private": true,
  "description": "Cleat API — multi-tenant Fastify server backed by PostgreSQL row-level security.",
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:dist": "node dist/db/migrate.js",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@cleat/core": "workspace:*",
    "@cleat/i18n": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
